DATABASE_URL=postgresql://user:pass@localhost:5432/soq_libya
PORT=5000
NODE_ENV=development
VAPID_PUBLIC_KEY=your_public_key
VAPID_PRIVATE_KEY=your_private_key
ENCRYPTION_KEY=32characterslongsecretkeyhere!

# Authentication — configure in the hosting provider's secret manager
# Google OAuth Web client ID (must match the audience used by the Android/web client)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# Generate a unique high-entropy value outside source control (e.g. openssl rand -base64 48)
JWT_SECRET=replace-with-a-long-random-secret-before-deployment
# Set exact allowed frontend origins in production, comma-separated; do not use *
CORS_ORIGINS=http://localhost:5173

# Optional: exact Google email allowed to become the initial admin; leave empty after setup
BOOTSTRAP_ADMIN_EMAIL=
